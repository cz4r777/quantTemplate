# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored — never commit secrets.
# ---------------------------------------------------------------------------

# --- IB Gateway / TWS connectivity ---
# Paper defaults shown. Live values must come from the live launcher path,
# not from this file. The bot refuses to boot live without all
# LIVE_* markers also set (see config.py for the canonical check).
IBKR_HOST=127.0.0.1
IBKR_PORT=4002                         # 4002 = IB Gateway paper, 7497 = TWS paper
IBKR_CLIENT_ID=6                       # any non-conflicting integer
IBKR_MODE=paper                        # paper | live
IBKR_ACCOUNT_ID=YOUR_PAPER_ACCOUNT_ID  # e.g. DUxxxxxxx for paper, Uxxxxxxx for live

# --- live-mode markers (DO NOT set unless going live via the launcher) ---
# LIVE_ACCOUNT_ID=Uxxxxxxx
# LIVE_MODE_CONFIRM=ENABLE LIVE TRADING ON ACCOUNT Uxxxxxxx
# LIVE_LAUNCHER_ONE_CYCLE=1
# LIVE_ROLLOUT_PHASE=phase1            # phase1 | phase2 | phase3

# --- risk knobs ---
MAX_POSITIONS=6
RISK_PER_TRADE=0.0125                  # fraction of equity

# --- data feed ---
FMP_API_KEY=                           # https://site.financialmodelingprep.com/

# --- notifications (optional) ---
NTFY_BASE_URL=https://ntfy.sh
NTFY_TOPIC=                            # your private ntfy topic; leave blank to disable

# --- dashboard mutation gate ---
# Required if you want /sell, /claim, etc. on the dashboard to actually
# fire. Generate with: openssl rand -hex 32
DASHBOARD_MUTATION_TOKEN=
